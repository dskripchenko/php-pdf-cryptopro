{
    "name": "dskripchenko/php-pdf-cryptopro",
    "description": "CryptoPro CSP signer for dskripchenko/php-pdf: sign PDFs (PAdES, GOST R 34.10-2012) with a key held by CryptoPro CSP on the server, through the phpcades extension.",
    "type": "library",
    "license": "MIT",
    "keywords": ["pdf", "signature", "pades", "cades", "cryptopro", "gost", "qes", "php-pdf"],
    "homepage": "https://github.com/dskripchenko/php-pdf-cryptopro",
    "authors": [
        {
            "name": "Denis Skripchenko",
            "email": "denskrp90@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-openssl": "*",
        "dskripchenko/php-pdf": "^1.18"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.0"
    },
    "suggest": {
        "ext-php_cades": "CryptoPro's PHP extension (phpcades) — required to sign with CryptoPro CSP"
    },
    "autoload": {
        "psr-4": {
            "Dskripchenko\\PhpPdfCryptoPro\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dskripchenko\\PhpPdfCryptoPro\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse",
        "api:record": "@php bin/api-record"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
